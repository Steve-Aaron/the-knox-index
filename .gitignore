# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
npm-debug.*
*.orig.*

# Environment — NEVER commit secrets
.env
.env.local
.env*.local

# Service account keys — NEVER commit
keys/
*-credentials.json
*service-account*.json

# Build artefacts
build/

# Firebase deploy cache (login.knox.digital auth-handler hosting)
.firebase/

# Project docs — briefs, reviews, planning notes.
# docs/api/ is the published developer documentation and IS tracked; everything
# else under docs/ stays private. Negation requires un-ignoring the parent dir
# first, hence the two-step: git cannot descend into an ignored directory.
docs/*
!docs/api/

# Email templates — design files, previews, drafts
# Not for publishing upstream; managed separately
email/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Expo generated
expo-env.d.ts
ios/
android/
.vercel
.claude/worktrees/
