# ── BigQuery ──────────────────────────────────────────────────────────────────
BIGQUERY_PROJECT_ID=project-ariadne
BIGQUERY_DATASET=ariadne_tiktok_demo

# ── Google Cloud credentials ──────────────────────────────────────────────────
# Local dev: path to the service account JSON key file
#   GOOGLE_APPLICATION_CREDENTIALS=./keys/your-key-file.json
#
# Production (Vercel / CI): paste the FULL JSON content of the key file as a
# single-line string. Vercel will inject it as an environment variable and the
# app will parse it automatically — no file needed.
#   GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_APPLICATION_CREDENTIALS=./keys/your-key-file.json

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PROMPT="You are an expert data analyst..."
