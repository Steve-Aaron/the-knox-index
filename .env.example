# ── BigQuery ──────────────────────────────────────────────────────────────────
BIGQUERY_PROJECT_ID=project-ariadne
BIGQUERY_DATASET=ariadne_tiktok_demo

# ── Google Cloud credentials ──────────────────────────────────────────────────
# IMPORTANT: this value is used by both lib/bigquery.ts and lib/gcs.ts. The
# parsing rule (after fix/redact-credentials-from-errors) is:
#
#   1. If it starts with `{` it MUST be valid single-line JSON. The lib will
#      throw a clean error if parsing fails — it will NOT fall through to
#      treating the value as a file path.
#   2. Otherwise it is treated as a path on disk.
#
# ── Local dev (recommended) ───────────────────────────────────────────────────
# Drop the JSON key file into ./keys/ (gitignored) and point at it:
#   GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json
#
# ── Production (Vercel) ───────────────────────────────────────────────────────
# Set the env var in the Vercel dashboard. Paste the JSON as a single-line
# string with `\n` escapes inside the private_key value, NOT raw newlines:
#   GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"…","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE…\n-----END PRIVATE KEY-----\n",…}
#
# Do not paste into a plain `.env.local` with raw newlines — `.env` parsers
# break on multi-line values, the JSON becomes malformed, and the lib will
# refuse to use it (which is by design).
GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PROMPT="You are an expert data analyst..."

# ── Auth (Firebase) ─────────────────────────────────────────────────────────────
# Identity is managed by Firebase Auth (passwordless email links + Google).
# Magic link emails are still sent through Brevo; sessions are Firebase
# session cookies stored httpOnly as `tki_auth` (14-day max, rolling).
#
# SERVER — service account for firebase-admin. Same parsing rule as
# GOOGLE_APPLICATION_CREDENTIALS above:
#   1. Starts with `{` → single-line JSON (Vercel; \n escapes in private_key)
#   2. Otherwise       → path on disk (local dev: ./keys/firebase-admin.json)
# Generate at: Firebase console → Project settings → Service accounts →
# Generate new private key.
FIREBASE_SERVICE_ACCOUNT=./keys/firebase-admin.json

# CLIENT — web app config (safe to expose; identifies the project, grants
# nothing). Firebase console → Project settings → General → Your apps →
# Web app → SDK setup and configuration.
#
# AUTH_DOMAIN serves the Google OAuth handler at /__/auth/handler. We use a
# branded custom domain (login.knox.digital) via a Firebase Hosting custom
# domain instead of the default *.firebaseapp.com. See the 'Custom auth
# domain' section in docs/auth-architecture.md for the one-time setup, and
# run `node scripts/check-auth-domain.mjs` to verify it is serving.
#
# These vars are inlined by Expo at BUILD time. After changing AUTH_DOMAIN you
# must rebuild: restart `npm run web` locally, and update the var in Vercel
# AND redeploy for production — a redeploy is required, env edits alone do not
# take effect.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=login.knox.digital
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# Console prerequisites (one-time):
#   1. Authentication → Sign-in method → enable 'Email/Password' AND tick
#      'Email link (passwordless sign-in)'
#   2. Authentication → Sign-in method → enable 'Google'
#   3. Authentication → Settings → Authorized domains → add
#      theknoxindex.knox.digital, index.knox.digital, login.knox.digital, localhost
#   4. Google Cloud → APIs & Services → Credentials → OAuth 2.0 web client →
#      Authorized redirect URIs → add
#      https://login.knox.digital/__/auth/handler

# ── Admin API allowlist ─────────────────────────────────────────────────────────
# Comma-separated emails allowed to use /api/admin/* (must also be signed in
# with a valid Firebase session). Unset = admin API disabled (fails closed).
ADMIN_EMAILS=steve@knoxdigi.com

# ── Brevo (email + subscription management) ───────────────────────────────────
# API key — single key drives /api/signup, /api/preferences, and the n8n
# Send Daily Briefing Email workflow. Generate at: app.brevo.com → SMTP & API.
BREVO_API_KEY=xkeysib-your-key-here

# Brevo list IDs. Each consent attribute is mirrored to its list; list
# membership is the canonical subscription state and is what the daily
# briefing n8n workflow reads from.
#   CONSENT_DAILY_BRIEFING     → list #4 (Knox Index Daily Briefing)
#   CONSENT_KNOX_INDEX_UPDATES → list #7 (Knox Index Updates)
#   CONSENT_KNOX_DIGITAL       → list #8 (Knox Digital — wider company)
BREVO_LIST_DAILY_BRIEFING=4
BREVO_LIST_KNOX_UPDATES=7
BREVO_LIST_KNOX_DIGITAL=8

# Transactional template ID for the daily briefing — set by
# email/scripts/brevo-upload-template.mjs after a template upload. Used
# by the n8n workflow's Send Brevo Email node.
BREVO_BRIEFING_TEMPLATE_ID=

# ── Internal API token ────────────────────────────────────────────────────────
# Shared bearer token for server-to-server endpoints like /api/sign-coverjpeg.
# Generate with: openssl rand -base64 32
# Set the same value as a credential in n8n (Header Auth, "Authorization: Bearer <token>").
INTERNAL_API_TOKEN=
