{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "devCommand": "npx expo start --web",
  "env": {
    "EXPO_OFFLINE": "1"
  },
  "functions": {
    "api/[...all].ts": {
      "includeFiles": "dist/server/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/mp/:path*", "destination": "/api/mp/:path*" },
    { "source": "/((?!_vercel/|_expo/|assets/|brand/).*)", "destination": "/api/[...all]" }
  ]
}
